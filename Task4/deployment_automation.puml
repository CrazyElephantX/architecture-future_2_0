@startuml Deployment_Automation_Future_2_0
title Будущее 2.0 - Диаграмма автоматизации развёртывания (с подсетями и защищённым контуром)

skinparam shadowing false
skinparam componentStyle rectangle
skinparam wrapWidth 220
skinparam roundCorner 8
skinparam defaultFontName "Inter, Segoe UI, Arial"

legend left
  зелёный - управляется Terraform (IaC)
  серый - вручную/за рамками IaC (ПО, лицензии, доступы)
  пунктирная граница --- защищённый контур (чувствительная зона)
endlegend

package "Cloud Landing Zone (dev/test/prod)" <<Cloud>> #EEE {
  component "VPC/VNet\n<<TF>>" as VPC #88CC88
  node "NAT + Egress\n(без публичных IP)\n<<TF>>" as NAT #88CC88
  node "Bastion/VPN\nдоступ админов\n<<Manual>>" as BASTION #DDDDDD

  ' Подсеть app
  rectangle "Подсеть app\n(10.0.1.0/24)" as SUBNET_APP #LightBlue {
    package "Apps" {
      node "Superset x1\nVM\n<<TF>>" as SUPERSET #88CC88
      node "Apache Camel x2\nIntegration\n<<TF>>" as CAMEL #88CC88
    }
  }

' Граница защищённого контура (чувствительная зона)
rectangle "Защищённый контур\n(PHI/PII данные)" <<secure>> #FFE6E6;line.dashed {



  ' Подсеть data
  rectangle "Подсеть data\n(10.0.2.0/24)" as SUBNET_DATA #LightGreen {
    package "Data Platform" {
      node "Kafka Cluster x3\nVM + Disks\n<<TF>>" as KAFKA #88CC88
      node "ClickHouse x3\nVM + Disks\n<<TF>>" as CH #88CC88
      node "Flink x2\nVM\n<<TF>>" as FLINK #88CC88
      node "MinIO (S3) x2\nVM + Disks\n<<TF>>" as MINIO #88CC88
    }
  }

  ' Подсеть secure (защищённый контур)
  rectangle "Подсеть secure\n(10.0.3.0/24)" as SUBNET_SECURE #LightCoral {
    package "Secure Services" {
      node "De-ID/Tokenization x1\nVM\n<<TF>>" as DEID #88CC88
      node "MDM x1\nVM\n<<TF>>" as MDM #88CC88
    }
  }
}
  ' Подсеть mgmt
  rectangle "Подсеть mgmt\n(10.0.4.0/24)" as SUBNET_MGMT #LightGray {
    node "Monitoring/Logging\n<<Manual>>" as MONITOR #DDDDDD
  }

  database "Legacy DWH\nSQL Server 2008\n(read-only)\n<<Manual>>" as DWH #DDDDDD
  node "Power BI / Portal\n(пользовательские ПК/SAAS)\n<<Manual>>" as PBI #DDDDDD
}

' Связи и потоки
VPC -down- NAT
BASTION -left- SUBNET_MGMT

' Связи внутри подсетей и между ними
CAMEL -down-> KAFKA : события/CDC [интеграция]
CAMEL -down-> MINIO : файлы/лог [интеграция]
KAFKA -down-> MINIO : sink [данные]
MINIO -down-> FLINK : чтение потоков [данные]
FLINK -down-> CH : трансформации -> витрины [данные]

SUPERSET -down-> CH : аналитика (read-only) [аналитика]
DEID -left-> CAMEL : де-идентиф. каналы [безопасность]
MDM -left-> CAMEL : мастер-данные [интеграция]

DWH -left-> CAMEL : CDC/реплика (read) [интеграция]
PBI -down-> CH : Direct Query / коннектор (read) [аналитика]

' Административные связи
BASTION --> SUBNET_APP : SSH/RDP [администрирование]
BASTION --> SUBNET_DATA : SSH [администрирование]
BASTION --> SUBNET_SECURE : SSH (с MFA) [администрирование]
BASTION --> SUBNET_MGMT : SSH [администрирование]

' Заметки
note top of NAT
  Точка исхода в интернет (egress)
  Правила egress ограничены, inbound = 0
end note

note right of BASTION
  Создаётся вручную: доступы, MFA, ключи в Terraform не моделируется
end note

note right of DWH
  Легаси остаётся на своей площадке. Только чтение/CDC
end note

note bottom of SUBNET_SECURE
  Компоненты с PHI/PII данными.
  Доступ только через Bastion с MFA.
  Шифрование на лету и на покое.
end note

@enduml
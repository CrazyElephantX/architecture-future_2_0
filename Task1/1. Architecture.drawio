        <object placeholders="1" c4Name="Apache superset" c4Type="Container" c4Technology="Apache superset" c4Description="Аналитика через Apache superset, like портал самообслуживая. Если есть ограничения, то делаем классический бэкэнд/фронтенд портал для аналитиков данных" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="pbEEcOnb8SaNBlA0rvnC-47">
          <mxCell parent="1" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;strokeColor=#118ACD;fillColor=#23A2D9;strokeColor=#118ACD;strokeColor2=#0E7DAD;fontSize=12;fontColor=#ffffff;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];resizable=0;verticalAlign=middle;fontFamily=Helvetica;" vertex="1">
            <mxGeometry height="160" width="240" x="880" y="340" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="pbEEcOnb8SaNBlA0rvnC-51" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=middle;fontFamily=Helvetica;labelBackgroundColor=none;resizable=1;labelBorderColor=none;spacingTop=0;spacingLeft=10;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Между системами так же должны быть интеграции через свои api gateway.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;К примеру, если клиент сдал анализы, то данные должны уйти не только в контур работы с данными, но и в ии-сервис. При этом ии-сервис так же отдаст данные по анализам в контур работы с данными, если это необходимо&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="360" x="2030" y="-200" as="geometry" />
        </mxCell>
